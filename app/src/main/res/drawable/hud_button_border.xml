<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/jarvis_cyan_dim" />
            <stroke android:width="2dp" android:color="@color/jarvis_cyan" />
            <corners android:radius="2dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/jarvis_surface_light" />
            <stroke android:width="1dp" android:color="@color/jarvis_cyan" />
            <corners android:radius="2dp" />
        </shape>
    </item>
</selector>
