<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/jarvis_background">

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="@drawable/hud_panel_background"
        android:layout_margin="8dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/jarvis_cyan"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/developer_tag"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/tvStatusBanner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/status_system_ready"
            android:textColor="@color/jarvis_green_online"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/viewportContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="8dp"
        android:background="@color/jarvis_surface"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toTopOf="@id/bottomHud"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.camera.view.PreviewView
            android:id="@+id/cameraPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextureView
            android:id="@+id/rtspTextureView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <com.ankit.jarvisfacescanner.ui.JarvisReticleOverlay
            android:id="@+id/reticleOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/bottomHud"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp"
        android:background="@drawable/hud_panel_background"
        android:layout_margin="8dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/tvTelemetry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="INFERENCE: 0ms // MATCH: NONE // ENGINE: OFFLINE"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnToggleScan"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="@string/btn_start_scan"
                android:background="@drawable/hud_button_border"
                android:textColor="@color/jarvis_cyan"
                android:fontFamily="monospace"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnEnroll"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="@string/btn_enroll"
                android:background="@drawable/hud_button_border"
                android:textColor="@color/jarvis_cyan"
                android:fontFamily="monospace"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnProfiles"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="@string/btn_profiles"
                android:background="@drawable/hud_button_border"
                android:textColor="@color/jarvis_cyan"
                android:fontFamily="monospace"
                android:layout_marginEnd="4dp" />

            <ImageButton
                android:id="@+id/btnSettings"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@android:drawable/ic_menu_preferences"
                android:background="@drawable/hud_button_border"
                app:tint="@color/jarvis_cyan"
                android:contentDescription="Settings" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
